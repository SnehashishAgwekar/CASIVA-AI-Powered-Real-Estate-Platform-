DATABASE_URL=postgresql://realestate_user:realestate_password@localhost:5432/real_estate_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
TAVILY_API_KEY=
# Fallback scraper for listing sites that block Tavily's fetcher (Cloudflare/
# PerimeterX-style WAFs, common on real estate portals). Sign up for a free
# trial at scraperapi.com, then paste your key here. Leave unset to skip the
# fallback (Tavily-only, with the "paste the description" option in the UI).
# SCRAPERAPI_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string
# GROQ_API_KEY=

# --- Property photo storage (Supabase Storage) ---
# Leave these unset to fall back to saving uploads on local disk (only
# visible from whichever machine's backend received the upload) — fine for
# solo use, but photos won't be visible to anyone sharing your database.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=property-images

# --- Broker notifications on "Interested" (SMS + WhatsApp + email) ---
# Leave these unset to keep notifications dormant (send calls will error and
# be logged, but the Interested flow itself still succeeds).
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# WASENDER_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# SMS_DEFAULT_COUNTRY_CODE=+91
